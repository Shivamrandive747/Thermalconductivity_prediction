# Copied to .gitignore in the release by make_release.py.
# (Kept under a different name here so it does not apply to release_assets/ in the working copy.)

# ---- generated artefacts -------------------------------------------------------------------
# Figures are committed as PDF, which is what the manuscript includes. The .png siblings the
# figure scripts also emit are for quick inspection only.
paper/figures/*.png

# Network caches written by the citation gate on first run.
data/external/crossref_cache.json
data/external/*_cache.json

# Analysis outputs are regenerated by the scripts; the curated ones are committed deliberately
# and listed in LICENSE-DATA. Anything else that lands here is a by-product.
data/exports/kappa_v2/*.tmp

# ---- python ----------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# CatBoost writes a training-log directory next to wherever it is run.
catboost_info/

# ---- environments and secrets ----------------------------------------------------------------
# No key material belongs in this repository. .env is listed so that a contributor who creates one
# locally cannot commit it by accident.
.env
.env.*
secrets/
.venv*/
venv/

# ---- editor / OS ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
